# ==============================================================================
# ZONABET - Variáveis de Ambiente (.env.example)
# Copie este ficheiro para .env e preencha com as suas configurações
# ==============================================================================

# Configuração do Servidor Express
PORT=3000
NODE_ENV=production

# Segurança e Autenticação (JWT)
# Gere uma chave aleatória e segura (ex: openssl rand -base64 32)
JWT_SECRET=substitua_por_uma_chave_secreta_longa_e_segura

# Integração Supabase (Banco de Dados e Persistência)
# Obtenha em: Painel Supabase -> Project Settings -> API
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=seu_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=seu_supabase_service_role_secret_key

# Variáveis Públicas para o Frontend Vite (opcional se servido via backend)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=seu_supabase_anon_public_key

# Conexão PostgreSQL Direta (opcional se usar PostgreSQL próprio em vez de Supabase)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/zonabet_db?schema=public

# Limites de Aposta (Opcional - padrões aplicados se omitido)
MINIMUM_STAKE=10
MAXIMUM_STAKE=50000
MAXIMUM_POTENTIAL_WIN=1000000
